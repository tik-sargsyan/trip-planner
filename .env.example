# Copy to .env.local for local dev. Vercel sets these in Project Settings > Environment Variables.
# Random secret for Auth.js. Generate with: npx auth secret
AUTH_SECRET=
# Neon Postgres (Vercel Marketplace sets this for you)
DATABASE_URL=
# Google sign-in (console.cloud.google.com > Credentials > OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional GitHub sign-in (github.com/settings/developers > OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
